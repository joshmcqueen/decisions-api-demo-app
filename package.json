{
  "name": "amazon-listing-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "evaluate": "tsx scripts/evaluate.ts",
    "onsite:prepare": "tsx scripts/prepare-onsite.ts",
    "onsite:reset": "tsx scripts/prepare-onsite.ts --reset",
    "onsite:mcp": "tsx server/mcp-index.ts",
    "onsite:eval": "mkdir -p tmp/promptfoo && PROMPTFOO_CONFIG_DIR=tmp/promptfoo PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c eval/promptfooconfig.mjs --no-cache --no-write --max-concurrency 1",
    "onsite:bind": "tsx scripts/bind-conversation.ts",
    "onsite:checkpoint": "node --import tsx scripts/rehearsal-checkpoint.ts",
    "onsite:restore": "node --import tsx scripts/rehearsal-checkpoint.ts --restore",
    "onsite:experiment": "node --import tsx scripts/evaluate-silent-record.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "jose": "6.2.18",
    "langsmith": "0.13.0",
    "lucide-react": "1.69.0",
    "openai": "7.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "promptfoo": "0.126.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
