# Server-only. Never use a VITE_ prefix for credentials.
OPENAI_API_KEY=
PORT=3001

# Optional redacted server traces.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=seller-validator-onsite
# Set ONSITE_TRACE=off to retain diagnostic spans only in local SQLite.

# ChatGPT uses the prepared-conversation handoff by default.
# Select mcp-read or mcp-write only after the corresponding hosted test.
ONSITE_HANDOFF=brief
# Optional detail page for the installed stable reviewer plugin.
ONSITE_PLUGIN_URL=
# Dedicated reviewer MCP listener and external OAuth configuration.
MCP_PORT=3002
MCP_RESOURCE=
MCP_ISSUER=
MCP_JWKS_URI=
MCP_MAYA_SUBJECT=
# For a short-lived rehearsal with the built-in synthetic issuer, set
# MCP_PRESENTER_OAUTH=1 and supply MCP_RESOURCE. Consent occurs on the Mac.
